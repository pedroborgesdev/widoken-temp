{
  "name": "widoken-ad-production",
  "version": "1.0.0",
  "description": "Production pipeline for the Widoken launch commercial (Remotion).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "capture": "node scripts/capture-product.mjs",
    "audio": "node scripts/make-audio.mjs",
    "voiceover": "bash scripts/voiceover.sh",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio",
    "styleframes": "node scripts/render-styleframes.mjs",
    "render": "remotion render src/index.ts WidokenAd output/widoken-comercial-1920x1080.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4",
    "render:v3": "remotion render src/index.ts WidokenAdV3 output/widoken-comercial-v3.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4",
    "render:v4": "remotion render src/index.ts WidokenAdV4 output/widoken-comercial-v4.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4",
    "render:v4.1": "remotion render src/index.ts WidokenAdV41 output/widoken-comercial-v4-1.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v4.2": "remotion render src/index.ts WidokenAdV42 output/widoken-comercial-v4-2.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v5": "remotion render src/index.ts WidokenAdV5 output/widoken-comercial-v5.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v6": "remotion render src/index.ts WidokenAdV6 output/widoken-comercial-v6.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v7": "remotion render src/index.ts WidokenAdV7 output/widoken-comercial-v7.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v8": "remotion render src/index.ts WidokenAdV8 output/widoken-comercial-v8.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v10": "remotion render src/index.ts WidokenAdV10 output/widoken-comercial-v10.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "render:v9": "remotion render src/index.ts WidokenAdV9 output/widoken-comercial-v9.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4 --port=3101",
    "audit:v4": "node scripts/audit-v4.mjs",
    "audit:v4.1": "node scripts/audit-v4-1.mjs",
    "audit:v4.2": "node scripts/audit-v4-2.mjs",
    "audit:v5": "node scripts/audit-v5.mjs",
    "audit:v6": "node scripts/audit-v6.mjs",
    "audit:v7": "node scripts/audit-v7.mjs",
    "audit:v8": "node scripts/audit-v8.mjs",
    "audit:v10": "node scripts/audit-v10.mjs",
    "audit:v9": "node scripts/audit-v9.mjs",
    "audit:v3": "node scripts/audit-v3.mjs",
    "render:all": "npm run render:v3 && npm run render && npm run render:v1",
    "render:v1": "remotion render src/index.ts WidokenAdV1 output/widoken-comercial-v1-1920x1080.mp4 --codec=h264 --audio-codec=aac --crf=17 --pixel-format=yuv420p --color-space=bt709 --concurrency=4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@remotion/cli": "^4.0.537",
    "@remotion/player": "^4.0.537",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
